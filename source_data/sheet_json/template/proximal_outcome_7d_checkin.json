{
  "flow_type": "template",
  "flow_subtype": "proximal_outcomes",
  "flow_name": "proximal_outcome_7d_checkin",
  "status": "released",
  "rows": [
    {
      "name": "hidden_pages",
      "value": "@calc(\" \" + @global.proximal_outcome_hidden_pages + \" \")",
      "exclude_from_translation": true,
      "comments": "Page ids to hide, padded with spaces so qs_base_1 doesn't match inside qs_base_10. Must stay text (not a list): the loop filter needs it as text."
    },
    {
      "name": "page_ids",
      "value": "@calc(Object.keys(@data.proximal_outcome_7d_pages))",
      "exclude_from_translation": true,
      "comments": "All page ids in list order."
    },
    {
      "name": "visible_count",
      "value": "@calc([].concat(@local.page_ids).filter(id => !(@local.hidden_pages).includes(\" \" + id + \" \")).length)",
      "exclude_from_translation": true,
      "comments": "Number of pages shown (for the progress bar)."
    },
    {
      "name": "last_page_index",
      "value": "@calc(Math.max(...[].concat(@local.page_ids).map((id, i) => (@local.hidden_pages).includes(\" \" + id + \" \") ? -1 : i)))",
      "exclude_from_translation": true,
      "comments": "value: row_index of the last page that is shown (was: last row), so page_last, page_finished and the last-page icon/title still work if the final page is hidden."
    },
    {
      "name": "module_article_count",
      "value": 0
    },
    {
      "type": "update_action_list",
      "name": "close_on_exit",
      "action_list": "uncompleted | nav_stack: close_top",
      "condition": "@fields.prox_outcome_access == \"cta\"",
      "comments": "for the closing button to work when accessed from the CTA"
    },
    {
      "type": "begin_data_items",
      "name": "loop_pages",
      "value": "@data.proximal_outcome_7d_pages",
      "parameter_list": "filter: !@item.completed && !(@local.hidden_pages).includes(\" \" + @item.id + \" \"); limit: 1",
      "comments": "parameter_list: skip hidden pages."
    },
    {
      "type": "begin_display_group"
    },
    {
      "name": "page_icon",
      "value": "images/icons/document-text-outline-thin.svg",
      "condition": "@item.row_index != @local.last_page_index"
    },
    {
      "name": "page_icon",
      "value": "images/icons/tick.svg",
      "condition": "@item.row_index == @local.last_page_index"
    },
    {
      "name": "page_title",
      "value": "@global.proximal_outcome_checkin_title",
      "condition": "@item.row_index != @local.last_page_index"
    },
    {
      "name": "page_title",
      "value": "@global.proximal_outcome_progress_title",
      "condition": "@item.row_index == @local.last_page_index"
    },
    {
      "name": "page_progress",
      "value": "@calc((Number(@local.module_article_count) + [].concat(@local.page_ids).slice(0, @item.row_index).filter(id => !(@local.hidden_pages).includes(\" \" + id + \" \")).length) / (Number(@local.module_article_count) + @local.visible_count) * 100)",
      "comments": "position and total count only shown pages, so the bar steps evenly."
    },
    {
      "type": "begin_template",
      "name": "page_header",
      "value": "proximal_outcome_header",
      "action_list": "uncompleted | emit: uncompleted"
    },
    {
      "name": "title",
      "value": "@local.page_title"
    },
    {
      "name": "icon_asset",
      "value": "@local.page_icon"
    },
    {
      "name": "show_progress",
      "value": true
    },
    {
      "name": "progress",
      "value": "@local.page_progress"
    },
    {
      "type": "end_template"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_template",
      "name": "page_@item.row_index",
      "value": "proximal_outcome_@item.id",
      "action_list": "completed | set_data |\n_list_id: proximal_outcome_7d_pages,\n_index: @item.row_index,\ncompleted: true;\n\nuncompleted | set_data |\n_list_id: proximal_outcome_7d_pages,\n_filter: @item.completed,\n_reverse: true,\n_limit: 1,\ncompleted: false;",
      "condition": "@fields.prox_outcome_access == \"cta\"",
      "comments": "Back now un-completes the last completed page instead of row_index - 1. Hidden pages are never completed, so they are skipped."
    },
    {
      "name": "po_type",
      "value": "7days"
    },
    {
      "type": "end_template"
    },
    {
      "type": "begin_template",
      "name": "page_@item.row_index",
      "value": "proximal_outcome_@item.id",
      "action_list": "completed | set_data |\n_list_id: proximal_outcome_7d_pages,\n_index: @item.row_index,\ncompleted: true;\n\nuncompleted | set_data |\n_list_id: proximal_outcome_7d_pages,\n_filter: @item.completed,\n_reverse: true,\n_limit: 1,\ncompleted: false;\nchanged | emit: changed;",
      "condition": "@fields.prox_outcome_access != \"cta\" && @item.row_index != @local.last_page_index"
    },
    {
      "name": "po_type",
      "value": "7days"
    },
    {
      "type": "end_template"
    },
    {
      "type": "begin_template",
      "name": "page_last",
      "value": "proximal_outcome_@item.id",
      "action_list": "completed | set_data |\n_list_id: proximal_outcome_7d_pages,\n_index: @item.row_index,\ncompleted: true;\n\ncompleted | emit: completed;\n\nuncompleted | set_data |\n_list_id: proximal_outcome_7d_pages,\n_filter: @item.completed,\n_reverse: true,\n_limit: 1,\ncompleted: false;",
      "condition": "@fields.prox_outcome_access != \"cta\" && @item.row_index == @local.last_page_index"
    },
    {
      "type": "end_template"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "begin_data_items",
      "name": "page_finished",
      "value": "@data.proximal_outcome_7d_pages",
      "parameter_list": "filter: @item.row_index == @local.last_page_index && @item.completed",
      "condition": "@fields.prox_outcome_access == \"cta\""
    },
    {
      "type": "lottie_animation",
      "name": "lottie",
      "value": "@global.proximal_outcome_completed_lottie_asset"
    },
    {
      "type": "title",
      "name": "finish_profile_title",
      "value": "@global.proximal_outcome_completed_title",
      "parameter_list": "variant: header"
    },
    {
      "type": "text",
      "name": "finish_profile_text",
      "value": "@global.proximal_outcome_completed_text",
      "parameter_list": "text_align: center"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "button",
      "name": "button_completed_3",
      "value": "@global.proximal_outcome_completed_button",
      "action_list": "click | emit: completed;\nclick | nav_stack: close_top;",
      "parameter_list": "style: navigation;",
      "comments": "so that the template closes and goes back home screen"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    }
  ]
}