{
  "flow_type": "template",
  "flow_name": "unlock_play",
  "status": "released",
  "rows": [
    {
      "name": "activity_id",
      "value": "@fields.latest_unlocked_activity"
    },
    {
      "name": "congratulation_text",
      "value": "@global.a_new_moment_of_play_has_been_unlocked"
    },
    {
      "name": "reward_assets",
      "value": "@global.unlock_play_animation_assets.split(\";\").map((v) => v.trim()).filter((v) => v)",
      "condition": "!!(@global.unlock_play_animation_assets)"
    },
    {
      "name": "reward_asset",
      "value": "@local.reward_assets[String(@local.activity_id).split(\"\").reduce((sum, c) => sum + c.charCodeAt(0), 0) % @local.reward_assets.length]",
      "condition": "!!(@global.unlock_play_animation_assets)"
    },
    {
      "type": "begin_display_group",
      "name": "dg_bg",
      "exclude_from_translation": true
    },
    {
      "type": "begin_display_group",
      "name": "dg_column",
      "parameter_list": "style: column",
      "exclude_from_translation": true
    },
    {
      "type": "lottie (lottie_animation)",
      "name": "reward_lottie",
      "value": "@local.reward_asset",
      "condition": "!!(@global.unlock_play_animation_assets) && @local.reward_asset.endsWith(\".json\")"
    },
    {
      "type": "image",
      "name": "reward_image",
      "value": "@local.reward_asset",
      "condition": "!!(@global.unlock_play_animation_assets) && !@local.reward_asset.endsWith(\".json\")"
    },
    {
      "type": "title",
      "name": "title",
      "value": "@global.hurrah",
      "parameter_list": "text_align: center; style: alternative",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "name": "text",
      "value": "@local.congratulation_text",
      "parameter_list": "text_align: center; style: alternative",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "name": "debug_id",
      "value": "@local.activity_id",
      "condition": false,
      "exclude_from_translation": true
    },
    {
      "type": "button",
      "name": "button",
      "value": "@global.open_your_moment_of_play",
      "action_list": "click | emit: completed; \nclick | nav_stack: open | template: activity_@local.activity_id, header: false;\nclick | set_data | \n_list_id: activity_tasks,\n_id: @local.activity_id,\naccessed: true",
      "parameter_list": "style: navigation",
      "exclude_from_translation": true
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_display_group"
    }
  ]
}