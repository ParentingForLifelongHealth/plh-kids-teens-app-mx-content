{
  "flow_type": "template",
  "flow_name": "support_list",
  "status": "released",
  "comments": "Support category list (replaces library_section_support)",
  "rows": [
    {
      "name": "library_id",
      "value": "support",
      "exclude_from_translation": true,
      "comments": "Title and intro still come from the library_section row 'support'"
    },
    {
      "name": "library_id_concat",
      "value": "library_section.@local.library_id",
      "exclude_from_translation": true
    },
    {
      "name": "library_row",
      "value": "@data.@local.library_id_concat",
      "exclude_from_translation": true
    },
    {
      "type": "begin_template",
      "name": "header",
      "value": "section_header",
      "action_list": "uncompleted | emit: uncompleted",
      "exclude_from_translation": true
    },
    {
      "name": "title",
      "value": "@local.library_row.title",
      "exclude_from_translation": true
    },
    {
      "type": "end_template",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "name": "intro",
      "value": "@local.library_row.introduction",
      "condition": "!!@local.library_row.introduction",
      "exclude_from_translation": true
    },
    {
      "type": "begin_display_group",
      "name": "dg_pages",
      "parameter_list": "style: column;",
      "exclude_from_translation": true,
      "comments": "Settings layout, but no inline_padding: unlike settings (page_padding 24px 0) this page keeps its normal padding"
    },
    {
      "type": "begin_items",
      "name": "pages",
      "value": "@data.support_page",
      "exclude_from_translation": true,
      "comments": "One button per support_page row, in sheet order"
    },
    {
      "type": "begin_display_group",
      "name": "card_@item.id",
      "parameter_list": "style: column;",
      "style_list": "background-color: var(--display-group-box-background); \nborder-radius: var(--ion-border-radius-rounded);",
      "exclude_from_translation": true,
      "comments": "Bone card: box background; corners match the button press highlight"
    },
    {
      "type": "button",
      "name": "button_@item.id",
      "value": "@item.title",
      "action_list": "click | set_field: support_page_id: @item.id; \nclick | go_to: support_page_one",
      "parameter_list": "variant: card; style: no-background; \ntext_align: left; \nicon_secondary_asset: chevron-forward; \nicon: @item.icon;",
      "exclude_from_translation": true,
      "comments": "Optional left icon from support_page.icon (empty = none)"
    },
    {
      "type": "end_display_group",
      "exclude_from_translation": true
    },
    {
      "type": "end_items",
      "exclude_from_translation": true
    },
    {
      "type": "end_display_group",
      "exclude_from_translation": true
    }
  ]
}