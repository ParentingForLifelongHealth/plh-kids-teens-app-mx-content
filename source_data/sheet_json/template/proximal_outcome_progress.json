{
  "flow_type": "template",
  "flow_subtype": "proximal_outcomes",
  "flow_name": "proximal_outcome_progress",
  "status": "released",
  "rows": [
    {
      "value": "proximal_outcome_progress_intro"
    },
    {
      "name": "speaker_position",
      "value": "left",
      "exclude_from_translation": true
    },
    {
      "name": "variant",
      "value": "gray",
      "exclude_from_translation": true
    },
    {
      "name": "facilitator_id",
      "value": "@fields.facilitator_id",
      "exclude_from_translation": true
    },
    {
      "name": "facilitator_data",
      "value": "characters.@local.facilitator_id",
      "exclude_from_translation": true
    },
    {
      "name": "facilitator_row",
      "value": "@data.@local.facilitator_data",
      "exclude_from_translation": true
    },
    {
      "name": "speaker_name",
      "value": "@local.facilitator_row.name",
      "exclude_from_translation": true
    },
    {
      "name": "speaker_image_asset",
      "value": "@local.facilitator_row.image_asset",
      "exclude_from_translation": true
    },
    {
      "name": "goal_data_row",
      "value": "goals.@fields.selected_goal_id"
    },
    {
      "name": "qs1_data_row",
      "value": "proximal_outcomes.@fields.proximal_outcome_base_1_id"
    },
    {
      "name": "qs2_data_row",
      "value": "proximal_outcomes.@fields.proximal_outcome_base_2_id"
    },
    {
      "name": "goal_data",
      "value": "@data.@local.goal_data_row"
    },
    {
      "name": "qs1_data",
      "value": "@data.@local.qs1_data_row"
    },
    {
      "name": "qs2_data",
      "value": "@data.@local.qs2_data_row"
    },
    {
      "name": "question_column_name",
      "value": "question"
    },
    {
      "name": "goal_question_column",
      "value": "goal_data.@local.question_column_name"
    },
    {
      "name": "goal_question",
      "value": "@local.@local.goal_question_column"
    },
    {
      "name": "qs1_question_column",
      "value": "qs1_data.@local.question_column_name"
    },
    {
      "name": "qs1_question",
      "value": "@local.@local.qs1_question_column"
    },
    {
      "name": "qs2_question_column",
      "value": "qs2_data.@local.question_column_name"
    },
    {
      "name": "qs2_question",
      "value": "@local.@local.qs2_question_column"
    },
    {
      "type": "text_bubble",
      "name": "text_bubble",
      "value": "@global.proximal_outcome_progress_intro",
      "parameter_list": "speaker_image_asset: @local.speaker_image_asset;\nspeaker_name: @local.speaker_name;\nspeaker_position: @local.speaker_position;\nvariant: @local.variant;",
      "exclude_from_translation": true
    },
    {
      "type": "begin_advanced_dashed_box"
    },
    {
      "type": "text",
      "value": "@local.goal_question"
    },
    {
      "type": "begin_data_items",
      "name": "loop_goal",
      "value": "@data.proximal_outcome_data",
      "parameter_list": "filter: @item.question_type == 'goal';"
    },
    {
      "type": "text",
      "name": "text_goal_entry",
      "value": "@item.entry_point  @item.entry_point_count - @item.exited_ts: @item.value\n\n"
    },
    {
      "type": "text",
      "name": "text_goal_entry_reflection",
      "value": "@item.reflection",
      "condition": "!!@item.reflection"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_advanced_dashed_box"
    },
    {
      "type": "begin_advanced_dashed_box"
    },
    {
      "type": "text",
      "value": "@local.qs1_question"
    },
    {
      "type": "begin_data_items",
      "name": "loop_qs1",
      "value": "@data.proximal_outcome_data",
      "parameter_list": "filter: @item.question_type == 'qs1';"
    },
    {
      "type": "text",
      "name": "text_qs1_entry",
      "value": "@item.entry_point - @item.entry_point_count - @item.exited_ts: @item.value\n\n"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_advanced_dashed_box"
    },
    {
      "type": "begin_advanced_dashed_box"
    },
    {
      "type": "text",
      "value": "@local.qs2_question"
    },
    {
      "type": "begin_data_items",
      "name": "loop_qs2",
      "value": "@data.proximal_outcome_data",
      "parameter_list": "filter: @item.question_type == 'qs2';"
    },
    {
      "type": "text",
      "name": "text_qs2_entry",
      "value": "@item.entry_point - @item.entry_point_count - @item.exited_ts: @item.value\n\n\n"
    },
    {
      "type": "end_data_items",
      "value": "proximal_outcome_progress_final_msg"
    },
    {
      "type": "end_advanced_dashed_box"
    },
    {
      "type": "text_bubble",
      "name": "text_bubble",
      "value": "@global.proximal_outcome_progress_final_msg",
      "parameter_list": "speaker_image_asset: @local.speaker_image_asset;\nspeaker_name: @local.speaker_name;\nspeaker_position: @local.speaker_position;\nvariant: @local.variant;",
      "exclude_from_translation": true
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;"
    },
    {
      "type": "round_button",
      "name": "button_forward    ",
      "action_list": "click | emit: completed;",
      "parameter_list": "icon_src: @global.first_completion_icon;",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}