{
  "flow_type": "template",
  "flow_subtype": "proximal_outcomes",
  "flow_name": "onboarding_settings_set_chall",
  "status": "released",
  "rows": [
    {
      "name": "speaker_position",
      "value": "left",
      "exclude_from_translation": true
    },
    {
      "name": "variant",
      "value": "gray",
      "exclude_from_translation": true
    },
    {
      "name": "facilitator_id",
      "value": "@fields.facilitator_id",
      "exclude_from_translation": true
    },
    {
      "name": "facilitator_data",
      "value": "characters.@local.facilitator_id",
      "exclude_from_translation": true
    },
    {
      "name": "facilitator_row",
      "value": "@data.@local.facilitator_data",
      "exclude_from_translation": true
    },
    {
      "name": "speaker_name",
      "value": "@local.facilitator_row.name"
    },
    {
      "name": "speaker_image_asset",
      "value": "@local.facilitator_row.image_asset"
    },
    {
      "name": "displayed_challenge_ids"
    },
    {
      "type": "data_items",
      "name": "store_options",
      "value": "@data.challenges",
      "action_list": "data_changed | set_local: displayed_challenge_ids: @items.map(i => i.id).join(\",\")",
      "parameter_list": "filter: (!@item.domain_list || @item.domain_list.includes(@fields.selected_domain_id)) &&(!@item.child_age_list || @item.child_age_list.includes(@fields.child_age)) && (!@item.child_gender_list || @item.child_gender_list.includes(@fields.child_gender)) && (!@item.caregiver_gender_list || @item.caregiver_gender_list.includes(@fields.user_gender)) && (!@item.caregiver_relationship_list || @item.caregiver_relationship_list.includes(@fields.user_relationship))",
      "exclude_from_translation": true
    },
    {
      "type": "text_bubble",
      "name": "text_bubble",
      "value": "@global.set_challenge_intro",
      "parameter_list": "speaker_image_asset: @local.speaker_image_asset;\nspeaker_name: @local.speaker_name;\nspeaker_position: @local.speaker_position;\nvariant: @local.variant;",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "name": "question_challenge",
      "value": "@global.set_challenge_question"
    },
    {
      "type": "begin_radio_list",
      "name": "challenge_select",
      "parameter_list": "variant: card;\noptions_key: id;\noptions_value: title;\nvalue_as_object: true;\ninitial_selected_option_key: @fields.selected_challenge_id;",
      "exclude_from_translation": true
    },
    {
      "type": "begin_data_items",
      "value": "challenges",
      "parameter_list": "filter: (!@item.domain_list || @item.domain_list.includes(@fields.selected_domain_id)) &&(!@item.child_age_list || @item.child_age_list.includes(@fields.child_age)) && (!@item.child_gender_list || @item.child_gender_list.includes(@fields.child_gender)) && (!@item.caregiver_gender_list || @item.caregiver_gender_list.includes(@fields.user_gender)) && (!@item.caregiver_relationship_list || @item.caregiver_relationship_list.includes(@fields.user_relationship))",
      "exclude_from_translation": true
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list",
      "exclude_from_translation": true
    },
    {
      "name": "completed_enabled",
      "value": "!!@local.challenge_select",
      "exclude_from_translation": true
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_completed",
      "value": "@global.continue",
      "action_list": "click | set_field: selected_challenge_id: @local.challenge_select.key;\nclick | set_field: selected_challenge: @local.challenge_select;\nclick | set_data |\n_list_id: goal_setting_data,\n_id: challenge,\nselected_id: @local.challenge_select.key,\noptions_offered: @local.displayed_challenge_ids,\nexited_ts: @calc(now());\nclick | emit: completed;",
      "parameter_list": "style: navigation;\ndisabled: !@local.completed_enabled",
      "condition": "!@local.challenge_select || (@local.challenge_select && @local.challenge_select.key != \"other\")",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "button_completed_other_goal",
      "value": "@global.continue",
      "action_list": "click | set_field: selected_challenge_id: @local.challenge_select.key;\nclick | set_field: selected_challenge: @local.challenge_select;\nclick | set_field: selected_goal_id: other;\nclick | set_data |\n_list_id: onboarding_settings_pages,\n_id: set_goal,\ncompleted: true;\nclick | set_data |\n_list_id: goal_setting_data,\n_id: challenge,\nselected_id: @local.challenge_select.key,\noptions_offered: @local.displayed_challenge_ids,\nfree_text: @local.challenge_select.value,\nexited_ts: @calc(now());\nclick | set_data |\n_list_id: goal_setting_data,\n_id: goal,\noptions_offered: NA,\nselected_id: other;\nclick | emit: completed;",
      "parameter_list": "style: navigation;\ndisabled: !@local.completed_enabled",
      "condition": "@local.challenge_select && @local.challenge_select.key == \"other\"",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}