{
  "flow_type": "template",
  "flow_name": "home_screen_header",
  "status": "released",
  "rows": [
    {
      "name": "countdown_days",
      "value": "@fields.countdown_days"
    },
    {
      "name": "po_last_7d_ts",
      "value": "@global.proximal_outcome_due_from == \"viewed\" && @fields.prox_7d_viewed_ts ? @fields.prox_7d_viewed_ts : @fields.prox_7d_last_ts"
    },
    {
      "name": "po_last_14d_ts",
      "value": "@global.proximal_outcome_due_from == \"viewed\" && @fields.prox_14d_viewed_ts ? @fields.prox_14d_viewed_ts : @fields.prox_14d_last_ts"
    },
    {
      "name": "days_since_prox_7d_last",
      "value": "@calc(window.date_fns.differenceInDays(new Date(),new Date(new Date(@local.po_last_7d_ts).setHours(0,0,0,0))))",
      "comment": "Same expression as the module / hp review stacks."
    },
    {
      "name": "days_since_prox_14d_last",
      "value": "@calc(window.date_fns.differenceInDays(new Date(),new Date(new Date(@local.po_last_14d_ts).setHours(0,0,0,0))))"
    },
    {
      "name": "po_frequency",
      "value": "@global.proximal_outcome_frequency",
      "condition": "!@fields.completed_all",
      "comment": "Days between check-ins during the programme (7)."
    },
    {
      "name": "po_frequency",
      "value": "@global.proximal_outcome_post_frequency",
      "condition": "!!@fields.completed_all",
      "comment": "After programme completion: 30-day rhythm"
    },
    {
      "name": "po_due",
      "value": "!!@global.has_proximal_outcomes && @local.days_since_prox_7d_last >= @local.po_frequency",
      "comment": "Check-in due. Off unless the deployment sets has_proximal_outcomes"
    },
    {
      "name": "po_due_type",
      "value": "7days",
      "condition": "!@fields.completed_all && !(@local.days_since_prox_14d_last >= @global.proximal_outcome_frequency * @global.proximal_outcome_alternation)",
      "comment": "Same rule as the stacks; exact opposite of the next row so a missing timestamp falls back to 7days."
    },
    {
      "name": "po_due_type",
      "value": "14days",
      "condition": "!!@fields.completed_all || @local.days_since_prox_14d_last >= @global.proximal_outcome_frequency * @global.proximal_outcome_alternation",
      "comment": "Always the 14-day check-in after programme completion."
    },
    {
      "name": "hp_uncompleted_loaded",
      "value": false,
      "comment": " Set once loop_2 has loaded, so no button shows before the home-practice data is known."
    },
    {
      "name": "hp_uncompleted_ids"
    },
    {
      "type": "begin_data_items",
      "name": "loop_2",
      "value": "@data.hp_check_in",
      "action_list": "data_changed | set_local : hp_uncompleted_ids : @items.map(item => item.id);\ndata_changed | set_local : hp_uncompleted_loaded : true;",
      "parameter_list": "filter: !@item.unlocked_activity",
      "exclude_from_translation": true,
      "comment": " second action added (loaded flag)."
    },
    {
      "type": "end_data_items"
    },
    {
      "name": "hp_unlocked_loaded",
      "value": false,
      "comment": "Set once loop_1 has loaded."
    },
    {
      "name": "hp_unlocked_ids"
    },
    {
      "type": "begin_data_items",
      "name": "loop_1",
      "value": "@data.courses",
      "action_list": "data_changed | set_local : hp_unlocked_ids : @items.map(item => item.id);\ndata_changed | set_local : hp_unlocked_loaded : true;",
      "parameter_list": "filter: !!@item.completed_ts && window.date_fns.differenceInDays(new Date(),new Date(new Date(@item.completed_ts).setHours(0,0,0,0))) >= @local.countdown_days;\nsort: completed_ts;",
      "exclude_from_translation": true,
      "comment": "second action added (loaded flag)."
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "text",
      "name": "debug_1",
      "value": "@local.hp_unlocked_ids",
      "condition": false,
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "name": "debug_2",
      "value": "@local.hp_uncompleted_ids",
      "condition": false,
      "exclude_from_translation": true
    },
    {
      "name": "hp_id",
      "value": "@calc((@local.hp_unlocked_ids || []).find(x => (@local.hp_uncompleted_ids || []).includes(x)))",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "name": "debug_3",
      "value": "HP id: @local.hp_id",
      "condition": false,
      "exclude_from_translation": true
    },
    {
      "name": "hp_review_template",
      "value": "stack_hp_review_@local.hp_id",
      "exclude_from_translation": true
    },
    {
      "name": "hp_check_in_row",
      "value": "hp_check_in.@local.hp_id",
      "exclude_from_translation": true
    },
    {
      "name": "hp_check_in_data",
      "value": "@data.@local.hp_check_in_row",
      "exclude_from_translation": true
    },
    {
      "name": "hp_check_in_notification_text",
      "value": "@local.hp_check_in_data.notification_text",
      "exclude_from_translation": true
    },
    {
      "type": "begin_template",
      "value": "header_button",
      "condition": "!!@local.hp_id"
    },
    {
      "name": "title",
      "value": "@local.hp_check_in_notification_text",
      "exclude_from_translation": true
    },
    {
      "name": "pop_up",
      "value": true
    },
    {
      "name": "template",
      "value": "@local.hp_review_template",
      "exclude_from_translation": true
    },
    {
      "name": "action_text",
      "value": "@global.review_action_text"
    },
    {
      "name": "badge_text",
      "value": "@global.review_badge_text"
    },
    {
      "type": "end_template"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "condition": "!@local.hp_id && !!@local.hp_unlocked_loaded && !!@local.hp_uncompleted_loaded",
      "comment": "waits for both loaded flags (stops the up-next button flashing before the review button)."
    },
    {
      "type": "plh_get_up_next",
      "name": "up_next"
    },
    {
      "type": "text",
      "value": "up_next value:",
      "condition": false
    },
    {
      "type": "text",
      "value": "@calc(JSON.stringify(@local.up_next || {}))",
      "condition": false
    },
    {
      "name": "start_at_id",
      "value": "_start_at_id"
    },
    {
      "name": "target_template",
      "value": "not used",
      "exclude_from_translation": true
    },
    {
      "name": "has_in_progress",
      "comment": "Empty on purpose: == 0 and > 0 are both false until loaded."
    },
    {
      "type": "data_items",
      "name": "get_last_in_progress",
      "value": "@data.module_tasks",
      "action_list": "data_changed | set_local : has_in_progress : @items.length;",
      "parameter_list": "filter: !!@item.last_accessed_ts && !@item.completed && (!@item.tag_list || @item.tag_list.includes(@fields.child_age_tag)) && (!@item.age_list || @item.age_list.includes(@fields.child_age)) && (!@item.child_gender_list || @item.child_gender_list.includes(@fields.child_gender)) && (!@item.user_gender_list || @item.user_gender_list.includes(@fields.user_gender)) && (!@item.caregiver_relationship_list || @item.caregiver_relationship_list.includes(@fields.user_relationship)); sort: last_accessed_ts; reverse;",
      "comment": "A module has been started but not finished (same test as V3 module › get_last_in_progress)."
    },
    {
      "type": "begin_template",
      "name": "proximal_outcome",
      "value": "proximal_outcome_header_b",
      "condition": "(@local.has_in_progress == 0) && @local.po_due",
      "comment": "Check-in button: only when no module is in progress and a check-in is due."
    },
    {
      "name": "po_type",
      "value": "@local.po_due_type"
    },
    {
      "type": "end_template"
    },
    {
      "type": "begin_template",
      "value": "header_button",
      "condition": "!!@local.up_next.module_id && ((@local.has_in_progress > 0) || !@local.po_due)",
      "exclude_from_translation": true,
      "comment": " also hidden while the check-in button shows. With no check-ins (po_due false) it behaves as before."
    },
    {
      "name": "title",
      "value": "@local.up_next.module_title",
      "exclude_from_translation": true
    },
    {
      "name": "course_id",
      "value": "@local.up_next.course_id",
      "exclude_from_translation": true
    },
    {
      "name": "subtitle",
      "value": "@local.up_next.course_title",
      "exclude_from_translation": true
    },
    {
      "name": "template",
      "value": "stack_module_@local.up_next.module_id@local.start_at_id",
      "exclude_from_translation": true
    },
    {
      "name": "pop_up",
      "value": true
    },
    {
      "name": "action_text",
      "value": "@global.course_action_text",
      "exclude_from_translation": true
    },
    {
      "name": "badge_text",
      "value": "@global.course_badge_text",
      "exclude_from_translation": true
    },
    {
      "name": "module_id",
      "value": "@local.up_next.module_id",
      "exclude_from_translation": true
    },
    {
      "type": "end_template",
      "exclude_from_translation": true
    },
    {
      "type": "begin_display_group",
      "name": "all_completed",
      "parameter_list": "style: column;",
      "condition": "!!@local.up_next.check_complete && !@local.up_next.module_id",
      "exclude_from_translation": true
    },
    {
      "type": "title",
      "value": "@global.all_complete_title",
      "condition": "!!@global.all_complete_title",
      "exclude_from_translation": true,
      "style_list": "margin-top: -8px;"
    },
    {
      "type": "text",
      "value": "@global.all_complete_text",
      "condition": "!!@global.all_complete_text",
      "exclude_from_translation": true,
      "style_list": "margin-top: -6px;\nmargin-bottom: -8px;"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "exclude_from_translation": true,
      "style_list": "background-color: #669F4B40;"
    },
    {
      "type": "text",
      "exclude_from_translation": true
    },
    {
      "type": "image",
      "value": "@global.all_complete_image",
      "exclude_from_translation": true,
      "style_list": "width: 145px;\nheight: 110px;"
    },
    {
      "type": "text"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_display_group"
    }
  ]
}