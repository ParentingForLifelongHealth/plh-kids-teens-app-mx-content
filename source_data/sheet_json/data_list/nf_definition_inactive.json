{
  "flow_type": "data_list",
  "flow_subtype": "campaign_rows",
  "flow_name": "nf_definition_inactive",
  "status": "released",
  "rows": [
    {
      "id": "install_nudge",
      "workshop": "independent",
      "message_type": "inactive",
      "action_list": "sent | set_field: install_nudge_sent : true;",
      "priority": 1,
      "activation_condition_list": "@fields.n_modules_completed == 0 && @fields.last_module_in_progress == \"NA\"",
      "deactivation_condition_list": "@fields.install_nudge_sent",
      "campaign_list": "nf_inactive_day",
      "title::eng": "@calc((v => v[(Number(@fields.nf_variant_seed || 0)) % v.length]?.title)(Object.values(@data.nf_inactive_texts).filter(r => r.type_list?.includes(\"install_nudge\"))))",
      "text::eng": "@calc((v => v[(Number(@fields.nf_variant_seed || 0)) % v.length]?.text)(Object.values(@data.nf_inactive_texts).filter(r => r.type_list?.includes(\"install_nudge\"))))",
      "comment": "Day after the last visit, before the first module. Variant: nf_texts type install_nudge, picked by nf_variant_seed."
    },
    {
      "id": "positive_reinforcement",
      "workshop": "independent",
      "message_type": "inactive",
      "action_list": "sent | set_field: positive_reinforcement_sent : true;",
      "priority": 1,
      "activation_condition_list": "@fields.n_modules_completed > 0",
      "deactivation_condition_list": "@fields.positive_reinforcement_sent",
      "campaign_list": "nf_inactive_day",
      "title::eng": "@calc((v => v[(Number(@fields.nf_variant_seed || 0)) % v.length]?.title)(Object.values(@data.nf_inactive_texts).filter(r => r.type_list?.includes(\"positive_reinforcement\"))))",
      "text::eng": "@calc((v => v[(Number(@fields.nf_variant_seed || 0)) % v.length]?.text)(Object.values(@data.nf_inactive_texts).filter(r => r.type_list?.includes(\"positive_reinforcement\"))))",
      "comment": "Day after the first module is completed. Sent once (positive_reinforcement_sent)."
    },
    {
      "id": "resume_lesson_afternoon",
      "workshop": "independent",
      "message_type": "inactive",
      "action_list": "click | set_field: current_start_article_id: uncomplete;\nclick | go_to : home_screen;\nclick | nav_stack: open | template: stack_module_@fields.last_module_in_progress@global.start_at_id, header: false;",
      "priority": 1,
      "activation_condition_list": "@fields.last_module_in_progress != \"NA\"",
      "campaign_list": "nf_inactive_2_days_afternoon",
      "title::eng": "@calc((v => v[(Number(@fields.nf_variant_seed || 0)) % v.length]?.title)(Object.values(@data.nf_inactive_texts).filter(r => r.type_list?.includes(\"resume_lesson_afternoon\"))))",
      "text::eng": "@calc((v => v[(Number(@fields.nf_variant_seed || 0)) % v.length]?.text)(Object.values(@data.nf_inactive_texts).filter(r => r.type_list?.includes(\"resume_lesson_afternoon\"))))",
      "comment": "2 days after the last visit, a module in progress. Tap reopens it."
    },
    {
      "id": "resume_lesson_week",
      "workshop": "independent",
      "message_type": "inactive",
      "action_list": "click | set_field: current_start_article_id: uncomplete;\nclick | go_to : home_screen;\nclick | nav_stack: open | template: stack_module_@fields.last_module_in_progress@global.start_at_id, header: false;",
      "priority": 1,
      "activation_condition_list": "@fields.last_module_in_progress != \"NA\"",
      "campaign_list": "nf_inactive_week",
      "title::eng": "@calc((v => v[(Number(@fields.nf_variant_seed || 0) + 1) % v.length]?.title)(Object.values(@data.nf_inactive_texts).filter(r => r.type_list?.includes(\"resume_lesson_week\"))))",
      "text::eng": "@calc((v => v[(Number(@fields.nf_variant_seed || 0) + 1) % v.length]?.text)(Object.values(@data.nf_inactive_texts).filter(r => r.type_list?.includes(\"resume_lesson_week\"))))",
      "comment": "7 days after the last visit. Uses the next variant (seed + 1), so it differs from the 2-day one, as before."
    },
    {
      "id": "win_back_evening",
      "workshop": "independent",
      "message_type": "inactive",
      "priority": 1,
      "activation_condition_list": "@fields.last_module_in_progress == \"NA\" && !@fields.completed_all",
      "campaign_list": "nf_inactive_2_days_evening",
      "title::eng": "@calc((v => v[(Number(@fields.nf_variant_seed || 0)) % v.length]?.title)(Object.values(@data.nf_inactive_texts).filter(r => r.type_list?.includes(\"win_back_evening\"))))",
      "text::eng": "@calc((v => v[(Number(@fields.nf_variant_seed || 0)) % v.length]?.text)(Object.values(@data.nf_inactive_texts).filter(r => r.type_list?.includes(\"win_back_evening\"))))",
      "comment": "2 days after the last visit, no module in progress, programme not completed."
    },
    {
      "id": "win_back_week",
      "workshop": "independent",
      "message_type": "inactive",
      "priority": 1,
      "activation_condition_list": "@fields.last_module_in_progress == \"NA\" && !@fields.completed_all",
      "campaign_list": "nf_inactive_week",
      "title::eng": "@calc((v => v[(Number(@fields.nf_variant_seed || 0) + 1) % v.length]?.title)(Object.values(@data.nf_inactive_texts).filter(r => r.type_list?.includes(\"win_back_week\"))))",
      "text::eng": "@calc((v => v[(Number(@fields.nf_variant_seed || 0) + 1) % v.length]?.text)(Object.values(@data.nf_inactive_texts).filter(r => r.type_list?.includes(\"win_back_week\"))))",
      "comment": "7 days after the last visit. Next variant (seed + 1), so it differs from the 2-day one."
    }
  ]
}