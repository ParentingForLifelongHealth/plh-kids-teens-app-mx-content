{
  "flow_type": "generator",
  "flow_name": "gen_stack_module_start_at_id",
  "status": "released",
  "parameter_list": {
    "input_data_list": "modules",
    "output_flow_name": "stack_module_{@gen.id}_start_at_id",
    "output_flow_type": "template",
    "output_flow_subtype": "generated"
  },
  "rows": [
    {
      "name": "not_comp_count",
      "value": 0
    },
    {
      "name": "module_id",
      "value": "@gen.id"
    },
    {
      "name": "picked_activity_id"
    },
    {
      "type": "data_items",
      "name": "count_modules",
      "value": "@data.module_tasks",
      "action_list": [
        {
          "trigger": "data_changed",
          "action_id": "set_local",
          "args": [
            "not_comp_count",
            "@items.length"
          ],
          "_raw": "data_changed | set_local: not_comp_count: @items.length"
        }
      ],
      "parameter_list": [
        "filter: (@item.id !== @local.module_id) && !@item.completed && (!@item.age_list || @item.age_list.includes(@fields.child_age)) && (!@item.child_gender_list || @item.child_gender_list.includes(@fields.child_gender)) && (!@item.caregiver_relationship_list || @item.caregiver_relationship_list.includes(@fields.user_relationship))"
      ],
      "exclude_from_translation": true
    },
    {
      "name": "articles_suffix",
      "value": "_article_tasks"
    },
    {
      "name": "articles_list_name",
      "value": "@local.module_id@local.articles_suffix"
    },
    {
      "name": "articles_data",
      "value": "@data.@local.articles_list_name"
    },
    {
      "name": "module_article_count",
      "value": "@calc(Object.keys(@local.articles_data).length)"
    },
    {
      "name": "days_since_prox_7d_last",
      "value": "@calc(window.date_fns.differenceInDays(new Date(),new Date(new Date(@field.prox_7d_last_ts).setHours(0,0,0,0))))",
      "exclude_from_translation": true
    },
    {
      "name": "days_since_prox_14d_last",
      "value": "@calc(window.date_fns.differenceInDays(new Date(),new Date(new Date(@field.prox_14d_last_ts).setHours(0,0,0,0))))",
      "exclude_from_translation": true
    },
    {
      "name": "has_PO_questions",
      "value": "@local.days_since_prox_7d_last >= @global.proximal_outcome_frequency",
      "exclude_from_translation": true
    },
    {
      "name": "has_PO_7",
      "value": "@local.days_since_prox_14d_last < @global.proximal_outcome_frequency * @global.proximal_outcome_alternation",
      "exclude_from_translation": true
    },
    {
      "name": "has_PO_14",
      "value": "@local.days_since_prox_14d_last >= @global.proximal_outcome_frequency * @global.proximal_outcome_alternation",
      "exclude_from_translation": true
    },
    {
      "name": "PO_type",
      "exclude_from_translation": true
    },
    {
      "name": "show_PO",
      "value": false,
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "space",
      "condition": false,
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "space",
      "condition": false,
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "has_PO_questions: @local.has_PO_questions\ndays_since_prox_7d_last: @local.days_since_prox_7d_last\ndays_since_prox_14d_last: @local.days_since_prox_14d_last\nhas_PO_7: @local.has_PO_7\nhas_PO_14: @local.has_PO_14\nPO_type: @local.PO_type\nshow_PO: @local.show_PO\nm article count: @local.module_article_count\narticle list name: @local.articles_list_name",
      "condition": false,
      "exclude_from_translation": true
    },
    {
      "type": "data_items",
      "name": "pick_random_locked_activity",
      "value": "@data.activity_tasks",
      "action_list": [
        {
          "trigger": "data_changed",
          "action_id": "set_local",
          "args": [
            "picked_activity_id",
            "@items[0]?.id"
          ],
          "_raw": "data_changed | set_local: picked_activity_id: @items[0]?.id"
        }
      ],
      "parameter_list": [
        "filter: @item.locked && (@fields.child_age === undefined || !@item.child_age_list || ([].concat(@item.child_age_list)).map(x => String(x)).includes(String(@fields.child_age)))",
        "shuffle",
        "limit: 1"
      ],
      "condition": "!@local.picked_activity_id",
      "exclude_from_translation": true
    },
    {
      "name": "extra_steps",
      "value": 0
    },
    {
      "name": "extra_steps",
      "value": "@calc(Object.keys(@data.proximal_outcome_14d_pages).length)",
      "condition": "@local.has_PO_7"
    },
    {
      "name": "extra_steps",
      "value": "@calc(Object.keys(@data.proximal_outcome_7d_pages).length)",
      "condition": "@local.has_PO_14"
    },
    {
      "type": "template",
      "name": "module_start_at_id",
      "value": "module_start_at_id_get_unlock",
      "action_list": [
        {
          "trigger": "completed",
          "action_id": "set_data",
          "args": [],
          "_raw": "completed | set_data | _list_id: module_tasks, _id: @gen.id, unlocked_activity: TRUE",
          "params": {
            "_list_id": "module_tasks",
            "_id": "@gen.id",
            "unlocked_activity": true
          }
        },
        {
          "trigger": "completed",
          "action_id": "set_field",
          "args": [
            "latest_unlocked_activity",
            "@local.picked_activity_id"
          ],
          "_raw": "completed | set_field: latest_unlocked_activity: @local.picked_activity_id"
        },
        {
          "trigger": "completed",
          "action_id": "nav_stack",
          "args": [
            "close_top"
          ],
          "_raw": "completed | nav_stack: close_top"
        },
        {
          "trigger": "completed",
          "action_id": "pop_up",
          "args": [
            "unlock_play"
          ],
          "_raw": "completed | pop_up: unlock_play | variant: plh_completion",
          "params": {
            "variant": "plh_completion"
          }
        },
        {
          "trigger": "uncompleted",
          "action_id": "nav_stack",
          "args": [
            "close_top"
          ],
          "_raw": "uncompleted | nav_stack: close_top"
        }
      ],
      "condition": "!@local.has_PO_questions && !@local.show_PO",
      "rows": [
        {
          "name": "activity_id",
          "value": "@local.picked_activity_id"
        },
        {
          "name": "module_id",
          "value": "@gen.id"
        },
        {
          "name": "course_id",
          "value": "@gen.tag_course"
        },
        {
          "name": "unlock_all",
          "value": "@calc(@local.not_comp_count == 0)"
        },
        {
          "type": "nested_properties",
          "name": "module_start_at_id",
          "rows": [
            {
              "type": "nested_properties",
              "name": "module",
              "rows": [
                {
                  "name": "extra_steps",
                  "value": "@local.extra_steps"
                },
                {
                  "name": "picked_activity_id",
                  "value": "@local.picked_activity_id"
                },
                {
                  "name": "has_PO_7",
                  "value": "@local.has_PO_7"
                },
                {
                  "name": "has_PO_14",
                  "value": "@local.has_PO_14"
                }
              ]
            }
          ]
        },
        {
          "type": "nested_properties",
          "name": "module_start_at_id_unlock_all",
          "rows": [
            {
              "type": "nested_properties",
              "name": "module",
              "rows": [
                {
                  "name": "extra_steps",
                  "value": "@local.extra_steps"
                },
                {
                  "name": "picked_activity_id",
                  "value": "@local.picked_activity_id"
                },
                {
                  "name": "has_PO_7",
                  "value": "@local.has_PO_7"
                },
                {
                  "name": "has_PO_14",
                  "value": "@local.has_PO_14"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
